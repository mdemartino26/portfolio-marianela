# Copiá este archivo como ".env" y completá los valores.
# Firebase: Consola > Configuración del proyecto > Tus apps > App web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary (gratis): Dashboard > Settings > Upload > Upload presets (modo Unsigned).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Opcional: endpoint de Formspree (https://formspree.io/f/xxxxxxx) para que el
# formulario de contacto envíe el correo sin abrir el cliente de mail.
VITE_FORMSPREE_ENDPOINT=
